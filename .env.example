# Copy this file to ".env" (same folder as docker-compose.yml) and fill it in.
# Never share the .env file: it contains your Google OAuth secret.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
USER_GOOGLE_EMAIL=you@gmail.com

# Obsidian "Local REST API" plugin key (Obsidian > Settings > Local REST API)
OBSIDIAN_API_KEY=your-obsidian-api-key

# SearXNG secret key: any long random string (see README, "SearXNG key")
SEARXNG_SECRET=replace-with-a-long-random-string

# GitHub fine-grained token, read-only (Contents, Issues, Pull requests) - used by n8n
GITHUB_TOKEN=github_pat_your-token

# Folders on your PC (forward slashes)
VAULT_PATH=C:/Users/<you>/Documents/Vault
DOCUMENTS_PATH=C:/Users/<you>/Documents
DOWNLOADS_PATH=C:/Users/<you>/Downloads
